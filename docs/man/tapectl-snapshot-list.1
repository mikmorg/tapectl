.el .ds Aq '
.TH tapectl-snapshot-list 1  "tapectl-snapshot-list " 
.SH NAME
tapectl\-snapshot\-list \- List snapshots
.SH SYNOPSIS
\fBtapectl snapshot list\fR [\fB\-\-json\fR] [\fB\-\-unit\fR] [\fB\-\-dry\-run\fR] [\fB\-\-status\fR] [\fB\-v\fR|\fB\-\-verbose\fR] [\fB\-y\fR|\fB\-\-yes\fR] [\fB\-\-config\fR] [\fB\-h\fR|\fB\-\-help\fR] 
.SH DESCRIPTION
List snapshots
.SH OPTIONS
.TP
\fB\-\-json\fR
Output in JSON format
.TP
\fB\-\-unit\fR \fI<UNIT>\fR
Filter by unit name
.TP
\fB\-\-dry\-run\fR
Show what would be done without making changes
.TP
\fB\-\-status\fR \fI<STATUS>\fR
Filter by status
.TP
\fB\-v\fR, \fB\-\-verbose\fR
Enable verbose output
.TP
\fB\-y\fR, \fB\-\-yes\fR
Skip confirmation prompts
.TP
\fB\-\-config\fR \fI<CONFIG>\fR
Path to config file
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
