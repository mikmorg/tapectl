.el .ds Aq '
.TH tapectl-volume-deposit-list 1  "tapectl-volume-deposit-list " 
.SH NAME
tapectl\-volume\-deposit\-list \- List recorded deposits
.SH SYNOPSIS
\fBtapectl volume deposit list\fR [\fB\-\-json\fR] [\fB\-\-volume\fR] [\fB\-\-dry\-run\fR] [\fB\-v\fR|\fB\-\-verbose\fR] [\fB\-y\fR|\fB\-\-yes\fR] [\fB\-\-config\fR] [\fB\-h\fR|\fB\-\-help\fR] 
.SH DESCRIPTION
List recorded deposits
.SH OPTIONS
.TP
\fB\-\-json\fR
Output in JSON format
.TP
\fB\-\-volume\fR \fI<VOLUME>\fR
Only deposits of this volume
.TP
\fB\-\-dry\-run\fR
Show what would be done without making changes
.TP
\fB\-v\fR, \fB\-\-verbose\fR
Enable verbose output
.TP
\fB\-y\fR, \fB\-\-yes\fR
Skip confirmation prompts
.TP
\fB\-\-config\fR \fI<CONFIG>\fR
Path to config file
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
