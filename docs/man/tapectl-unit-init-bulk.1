.el .ds Aq '
.TH tapectl-unit-init-bulk 1  "tapectl-unit-init-bulk " 
.SH NAME
tapectl\-unit\-init\-bulk \- Bulk\-initialize subdirectories as units
.SH SYNOPSIS
\fBtapectl unit init\-bulk\fR [\fB\-\-json\fR] <\fB\-\-tenant\fR> [\fB\-\-dry\-run\fR] [\fB\-t\fR|\fB\-\-tag\fR] [\fB\-v\fR|\fB\-\-verbose\fR] [\fB\-y\fR|\fB\-\-yes\fR] [\fB\-\-config\fR] [\fB\-h\fR|\fB\-\-help\fR] <\fIPATH\fR> 
.SH DESCRIPTION
Bulk\-initialize subdirectories as units
.SH OPTIONS
.TP
\fB\-\-json\fR
Output in JSON format
.TP
\fB\-\-tenant\fR \fI<TENANT>\fR
Tenant name
.TP
\fB\-\-dry\-run\fR
Show what would be done without making changes
.TP
\fB\-t\fR, \fB\-\-tag\fR \fI<TAG>\fR
Tags to apply to all
.TP
\fB\-v\fR, \fB\-\-verbose\fR
Enable verbose output
.TP
\fB\-y\fR, \fB\-\-yes\fR
Skip confirmation prompts
.TP
\fB\-\-config\fR \fI<CONFIG>\fR
Path to config file
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fIPATH\fR>
Parent directory to scan
