.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH tapectl-unit-tag 1  "tapectl-unit-tag " 
.SH NAME
tapectl\-unit\-tag \- Add/remove tags
.SH SYNOPSIS
\fBtapectl unit tag\fR [\fB\-\-add\fR] [\fB\-\-json\fR] [\fB\-\-dry\-run\fR] [\fB\-\-remove\fR] [\fB\-v\fR|\fB\-\-verbose\fR] [\fB\-y\fR|\fB\-\-yes\fR] [\fB\-\-config\fR] [\fB\-h\fR|\fB\-\-help\fR] <\fINAME\fR> 
.SH DESCRIPTION
Add/remove tags
.SH OPTIONS
.TP
\fB\-\-add\fR \fI<ADD>\fR
Tags to add
.TP
\fB\-\-json\fR
Output in JSON format
.TP
\fB\-\-dry\-run\fR
Show what would be done without making changes
.TP
\fB\-\-remove\fR \fI<REMOVE>\fR
Tags to remove
.TP
\fB\-v\fR, \fB\-\-verbose\fR
Enable verbose output
.TP
\fB\-y\fR, \fB\-\-yes\fR
Skip confirmation prompts
.TP
\fB\-\-config\fR \fI<CONFIG>\fR
Path to config file
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fINAME\fR>
Unit name
